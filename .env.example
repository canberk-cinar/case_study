# Database
DATABASE_URL=sqlite:///./case_study.db

# Data paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=data/reports

# LLM (Case 8/9 RAG + agentic pipeline) — OpenAI-compatible endpoint.
# Defaults to OpenRouter (approved as a stand-in for local Ollama on RAM-constrained machines);
# repointable to Ollama's own OpenAI-compatible endpoint (http://localhost:11434/v1, any api key
# string) or another OpenAI-compatible provider with no code change.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Case 8 embedding model — a separate model id (OpenRouter's chat and embedding endpoints use
# different slugs), same OpenRouter key/base_url above. Chosen for retrieval quality (72.38 on
# RTEB) — see notebooks/case_08_rag_pipeline.ipynb for why TF-IDF alone wasn't enough.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

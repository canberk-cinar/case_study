# Database
DATABASE_URL=sqlite:///./case_study.db

# Data paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=data/reports

# LLM (Case 8/9 RAG + agentic pipeline).
# LLM_PROVIDER is the single switch for the whole RAG pipeline: "openrouter" (cloud default,
# this machine's RAM-constrained stand-in for local Ollama) or "ollama" (fully local once
# installed, pulls smollm2:360m + all-minilm on localhost:11434). Changing this one line swaps
# BOTH the embedding and chat provider at once; no code change. Everything below LLM_PROVIDER only
# matters when it's "openrouter".
LLM_PROVIDER=openrouter

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Case 8 embedding model: a separate model id (OpenRouter's chat and embedding endpoints use
# different slugs), same OpenRouter key/base_url above. Chosen for retrieval quality (72.38 on
# RTEB); see notebooks/case_08_rag_pipeline.ipynb for why TF-IDF alone wasn't enough.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

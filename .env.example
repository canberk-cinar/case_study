# LLM (Case 8/9 RAG + agentic pipeline) — OpenAI-compatible endpoint.
# Defaults to OpenRouter (approved as a stand-in for local Ollama on RAM-constrained machines);
# repointable to Ollama's own OpenAI-compatible endpoint (http://localhost:11434/v1, any api key
# string) or another OpenAI-compatible provider with no code change.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
